# Delegated supervisor external interrupt from DMA completion.
# Host setup preloads:
# - privilege = User
# - mideleg/sie enable supervisor external interrupts
# - stvec = 0x40
# - RAM at 0x1000_0000 contains 0x11223344 and 0x55667788
# Mainline programs the DMA source, destination, length, supervisor route,
# and control start+IRQ-enable, then spins at PC 0x30.
# The supervisor handler clears STATUS_DONE, writes x10 = 6, returns with sret,
# and user mainline resumes at PC 0x30.
# Expect x1 = 5, x10 = 6, scause = interrupt 9, sepc = 0x30, privilege = User.
