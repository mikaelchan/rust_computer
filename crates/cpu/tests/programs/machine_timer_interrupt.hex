# Machine timer interrupt from the memory-mapped timer device.
# Host setup preloads:
# - machine timer mapped at 0x3000_0000
# - mtimecmp = 1 so the timer interrupts almost immediately
# - mstatus.MIE and mie.MTIE enabled
# - mtvec = 0x20
# Mainline spins at PC 0, the handler pushes mtimecmp out to 32 cycles,
# records x10 = 1, and returns to the loop.
# Expect x10 = 1, mcause = interrupt 7, pc = 0.
0x0000006f
0x00000013
0x00000013
0x00000013
0x00000013
0x00000013
0x00000013
0x00000013
0x300000b7
0x02000113
0x0020a423
0x0000a623
0x00100513
0x30200073
0x00000013
