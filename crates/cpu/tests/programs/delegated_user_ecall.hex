# Delegated user ecall trap and sret return smoke test.
# Host setup preloads:
# - privilege = User
# - medeleg bit 8 so user ecall traps to Supervisor
# - stvec = 0x20
# Program flow:
# - user mode executes ecall at PC 0
# - supervisor handler writes sepc = 4, records a handler-side marker in x2,
#   returns with sret, and user mainline resumes at PC 4
# Expect x1 = 1, x2 = 7, scause = 8, sepc = 4, privilege = User, pc = 0x8.
