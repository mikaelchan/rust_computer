# User-mode machine-CSR access trapped by machine mode, with mret return.
# Host setup preloads:
# - privilege = User
# - mtvec = 0x20
# Mainline executes an illegal machine-CSR access, the machine handler records
# mcause/mtval, skips the faulting instruction by advancing mepc,
# returns with mret, and user code resumes at PC 0x4.
# Expect x1 = 0, x10 = 1, x11 = 2, x12 = faulting instruction, x13 = 1.
0x3000d0f3
0x00168693
0x0000006f
0x00000013
